{
  "name": "My New Tab",
  "version": "1.1.0",
  "description": "A sleek, modern glassmorphic new tab dashboard featuring bookmarks, shortcuts, clock, contest alerts, and sticky notes.",
  "manifest_version": 3,
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "activeTab",
    "favicon",
    "clipboardWrite"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action" : {
    "default_popup": "./pop_up/popup.html"
  },



  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}